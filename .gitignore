__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
data/raw/
data/external/
data/cache/
data/processed/
# Bulk raw generations (potentially large, scientifically important but not
# meant for git history) go here - keep excluded. Small provenance/milestone
# logs under artifacts/logs/ are intentionally NOT excluded (see docs/PRIOR_WORK_MATRIX.md
# process note and §56 of the continuation directive: small representative
# samples are fine to version, bulk raw output is not).
artifacts/responses/
*.safetensors
*.bin
*.pt
*.pth
*.gguf
.env
*.token

# Exact maintainer-workstation provenance (GPU UUIDs/PCI IDs, cache paths,
# auth-expiry detail) - scientifically useful facts derived from these live
# in public docs/ in abstracted form; the exact fingerprinting stays local.
# See docs/reproducibility.md and the "public vs maintainer-only
# provenance" note in docs/MODEL_AUDIT.md.
.local/


# labeling answer key artifacts/labeling/key_v1.csv was withheld only while annotation was
# blind; annotation completed 2026-10-10 and the key is now versioned (verified by
# scripts/verify_label_key.py).
artifacts/logs/dl/*.attempt.log

# commitment audit answer key: local-only until both audit sheets are labelled (blinding)
artifacts/labeling/commitment_audit_v1/key.csv

# Qwen commitment audit answer key: local-only until both sheets are labelled (blinding)
artifacts/labeling/commitment_audit_qwen_v1/key.csv
